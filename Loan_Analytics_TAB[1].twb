      </column>
      <column caption='ACTIVE CLIENTS' datatype='integer' name='[Calculation_0348859777769476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Client id] : MAX(IF [Loan Status] = &quot;Active&quot; THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='First Loan Year' datatype='integer' name='[Calculation_0348859782279180]' role='measure' type='quantitative'>
