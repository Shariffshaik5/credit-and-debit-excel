            <column caption='ACTIVE CLIENTS' datatype='integer' name='[Calculation_0348859777769476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Client id] : MAX(IF [Loan Status] = &quot;Active&quot; THEN 1 ELSE 0 END) }' />
            </column>
            <column caption='First Loan Year' datatype='integer' name='[Calculation_0348859782279180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Client id] : MIN(YEAR([Disbursement Date])) }' />
            </column>
            <column caption='New Clients' datatype='integer' name='[Calculation_0348859791351846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_0348859782279180] = [Parameters].[Parameter 0348859790729252] THEN [Client id] END)' />
            </column>
            <column caption='Client Active Previous Period' datatype='boolean' name='[Calculation_0348859791990824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [Client id] : MAX(IF YEAR([Disbursement Date]) = [Parameters].[Parameter 0348859790729252]-1 THEN 1 ELSE 0 END) } = 1' />
            </column>
            <column caption='`Client Retention Rate`' datatype='integer' name='[Calculation_0348859792736298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_0348859791990824] THEN [Client id] END)' />
            </column>
            <column caption='Total Loan Amount Disbursed' datatype='integer' name='[Calculation_0348859793719339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Loan Amount])' />
            </column>
            <column caption='Total Funded Amount' datatype='integer' name='[Calculation_0348859793952812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Funded Amount])' />
            </column>
            <column caption='Average Loan Size' datatype='real' name='[Calculation_0348859794124845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Loan Amount])' />
            </column>
            <column caption='This Period Loan Amount' datatype='integer' default-format='p0.00%' name='[Calculation_0348859794341934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Disbursement Date]) = [Parameters].[Parameter 0348859790729252] THEN [Loan Amount] END)' />
            </column>
            <column caption='Last Period Loan Amount' datatype='integer' default-format='p0.00%' name='[Calculation_0348859794587695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Disbursement Date]) = [Parameters].[Parameter 0348859790729252]-1 THEN [Loan Amount] END)' />
            </column>
            <column caption='Loan Growth %' datatype='real' default-format='p0.00%' name='[Calculation_0348859794726960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0348859794341934] - [Calculation_0348859794587695]) / ABS([Calculation_0348859794587695])' />
            </column>
            <column caption='Total Repayments Collected' datatype='integer' name='[Calculation_0348859795030065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Pymnt])' />
            </column>
            <column caption='Principal Recovery Rate' datatype='real' default-format='p0.00%' name='[Calculation_0348859795447858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Rec Prncp]) / SUM([Loan Amount])' />
            </column>
            <column caption='Interest Income' datatype='real' name='[Calculation_0348859795673139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Rrec int])' />
            </column>
            <column datatype='integer' name='[Client id]' role='dimension' type='ordinal' />
